{
    "name": "Python + Codex",
    "dockerComposeFile": "docker-compose.yml",
    "service": "dev",
    "workspaceFolder": "/workspace",
    "remoteUser": "vscode",
    "updateRemoteUserUID": true,
    "shutdownAction": "stopCompose",
    "customizations": {
        "vscode": {
            "extensions": [
                "openai.chatgpt",
                "ms-python.python",
                "ms-python.vscode-pylance",
                "ms-python.debugpy",
                "charliermarsh.ruff"
            ]
        }
    }
}